# GitHub Personal Access Token
# Crea uno en: https://github.com/settings/tokens
# Permisos necesarios:
#   - repo       (OBLIGATORIO para contar repos/estrellas/lenguajes PRIVADOS;
#                 con solo public_repo nunca verás datos privados)
#   - read:user
# Nota: los datos privados solo se cuentan cuando el token pertenece al mismo
# usuario que consultas (username == dueño del token).
PAT_1=ghp_your_token_here

# Puerto del servidor (opcional)
PORT=3000
